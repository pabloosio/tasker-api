# ===========================
# CONFIGURACIÓN DEL PROYECTO
# ===========================
# 
# IMPORTANTE: Copia este archivo a .env y completa los valores
# El archivo .env NUNCA debe commiterse (está en .gitignore)
#
# Para desarrollo local:
#   cp .env.example .env
#   Edita .env con tus valores locales
#
# ===========================

# ENTORNO
# development | production | test
NODE_ENV=development
PORT=3000

# BASE DE DATOS
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tasker_dev
DB_USER=root
DB_PASSWORD=

# AUTENTICACIÓN (JWT)
# Cambia esto en producción con una clave segura
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRE=7d

# RATE LIMITING
# Poner RATE_LIMIT_ENABLED=false para deshabilitar completamente (recomendado en LAN compartida)
RATE_LIMIT_ENABLED=false
# Ventana de tiempo en minutos
RATE_LIMIT_WINDOW=60
# Máximo requests por ventana por IP
RATE_LIMIT_MAX=50000

# CORS
# Para desarrollo: http://localhost:3000 o * 
# Para producción: especifica tu dominio
CORS_ORIGIN=*

# LOGGING
# error | warn | info | debug
LOG_LEVEL=info

# AWS SES (Para envío de emails)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_SES_REGION=us-east-1
SES_FROM_EMAIL=noreply@tasker.com

# ARCHIVOS ADJUNTOS (S3)
# Si S3_BUCKET está vacío, los adjuntos quedan deshabilitados y el resto de la app funciona igual.
# Credenciales: S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY (clave IAM solo para S3). Si se dejan vacías,
# se usan AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY de arriba o, en AWS, el rol IAM del servidor.
# Permisos mínimos sobre arn:aws:s3:::<bucket>/<prefijo>/*: s3:PutObject, s3:GetObject, s3:DeleteObject
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1
# Carpeta raíz dentro del bucket (una por ambiente)
S3_PREFIX=tasker/dev
# Solo para pruebas locales con un S3 compatible (MinIO). En AWS dejar vacío.
S3_ENDPOINT=
ATTACHMENTS_MAX_FILE_MB=20
ATTACHMENTS_MAX_PER_TASK=15
ATTACHMENTS_UPLOADS_PER_MINUTE=20

# FRONTEND URL (Para links en emails)
FRONTEND_URL=http://localhost:5173

# Email Tokens Expiry (en horas)
EMAIL_TOKEN_EXPIRY=24
PASSWORD_RESET_TOKEN_EXPIRY=1





